# Copier ce fichier en ".env" et ajuster si besoin. Ne pas committer le ".env" reel.

# PostgreSQL - Data Warehouse
DWH_POSTGRES_USER=dwh_user
DWH_POSTGRES_PASSWORD=dwh_password
DWH_POSTGRES_DB=weather_dwh
DWH_POSTGRES_PORT=5433

# PostgreSQL - metadonnees Airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Villes suivies par le pipeline (lat,lon,nom ; separees par ";")
WEATHER_CITIES="48.8566,2.3522,Paris;45.7640,4.8357,Lyon;43.2965,5.3698,Marseille;50.6292,3.0573,Lille;43.6047,1.4442,Toulouse"
